# ==============================================================================
# FarmSense AI — Environment Variables Example
# 
# Instructions:
# 1. Copy this file to .env (do NOT commit .env to version control)
# 2. Update the values with your actual production secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Boot Backend Configuration
# ------------------------------------------------------------------------------
# Server
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# JWT Authentication
# Generate a strong 256-bit (32 byte) key (e.g. openssl rand -base64 32)
JWT_SECRET=your_super_secret_base64_encoded_jwt_key_here_must_be_at_least_256_bits
JWT_EXPIRATION=604800000

# Database (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/farmsense
DB_USER=postgres
DB_PASS=your_secure_db_password

# ------------------------------------------------------------------------------
# 2. AI & External Services
# ------------------------------------------------------------------------------
# Ollama Configuration
OLLAMA_URL=http://localhost:11434

# Weather API (Optional - required for weather dashboard)
# Get a free key at openweathermap.org or similar
WEATHER_API_KEY=your_weather_api_key_here

# Translation API (Optional - for advanced dynamic content translation)
LIBRETRANSLATE_URL=http://localhost:5000/translate

# ------------------------------------------------------------------------------
# 3. React Frontend Configuration
# ------------------------------------------------------------------------------
# This must point to your backend API in production
REACT_APP_API_BASE_URL=https://api.yourdomain.com/api
