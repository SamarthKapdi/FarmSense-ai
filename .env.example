# ═══════════════════════════════════════════════════════════
# FarmSense AI — Environment Variables
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# The application reads these via Spring Boot's ${VAR:default} syntax.

# ── JWT Authentication ──
# REQUIRED: 64+ character secret for signing JWT tokens
# Generate: openssl rand -base64 64
JWT_SECRET=your-256-bit-secret-here-must-be-at-least-64-characters-long!!

# Token expiration in milliseconds (default: 7 days)
JWT_EXPIRATION=604800000

# ── Database (PostgreSQL) ──
DB_URL=jdbc:postgresql://localhost:5432/farmsense
DB_USER=postgres
DB_PASS=your-password

# ── Ollama AI Server ──
OLLAMA_URL=http://localhost:11434

# ── OpenWeatherMap API ──
# Get your key at: https://openweathermap.org/api
WEATHER_API_KEY=your-openweathermap-key

# ── LibreTranslate (optional) ──
LIBRETRANSLATE_URL=http://localhost:5000/translate

# ── Spring Profile ──
# Use 'dev' for local development, 'prod' for production
SPRING_PROFILES_ACTIVE=dev
